# ── Сервер ──────────────────────────────────────────────────────────
# Строка подключения SQLAlchemy. Читается server/uvicorn_config.py через python-dotenv.
# Если переменная не задана, используется локальный файл SQLite
# (sqlite+aiosqlite:///./kanban.db) и PostgreSQL не требуется.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kanban

# ── Клиент ──────────────────────────────────────────────────────────
# Базовый адрес REST и WebSocket API. По умолчанию http://localhost:8000.
# В Docker Compose задаётся сервисом web; для локального клиента — client/.env.
VITE_API_URL=http://localhost:8000
